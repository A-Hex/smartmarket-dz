# .env.example
# Copy to .env and adjust values before running docker-compose.

# --- App ---
ENVIRONMENT=development

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL ---
POSTGRES_USER=smartmarket
POSTGRES_PASSWORD=smartmarket
POSTGRES_DB=smartmarket
DATABASE_URL=postgresql+asyncpg://smartmarket:smartmarket@postgres:5432/smartmarket
DATABASE_URL_SYNC=postgresql+psycopg2://smartmarket:smartmarket@postgres:5432/smartmarket

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- File storage ---
UPLOAD_DIR=/app/storage/uploads
REPORT_DIR=/app/storage/reports
MAX_UPLOAD_SIZE_MB=200

# --- Rate limiting ---
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
